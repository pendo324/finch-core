# name=Fedora 42
# metalink=https://mirrors.fedoraproject.org/metalink?repo=updates-released-f42&arch=\$basearch
# enabled=1
# countme=1
# metadata_expire=7d
# repo_gpgcheck=0
# type=rpm
# gpgcheck=1
# gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-fedora-42
# skip_if_unavailable=False
# EOF'

# sudo dnf install -y \
#   --repo fedora42 \
#   fuse-sshfs


# Fix SELinux labels so systemd service can start
restorecon -R -v /usr/bin/

touch /etc/machine-id

